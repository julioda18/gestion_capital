<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="gestion_capital_compania_rule" model="ir.rule">
            <field name="name">Gestión de Capital: multi-compañía</field>
            <field name="model_id" ref="model_gestion_capital"/>
            <field name="domain_force">[('compania_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_admin_capital'))]"/>
        </record>

        <record id="gestion_accionista_compania_rule" model="ir.rule">
            <field name="name">Accionistas: multi-compañía</field>
            <field name="model_id" ref="model_gestion_accionista"/>
            <field name="domain_force">[('compania_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_admin_capital'))]"/>
        </record>
    </data>
</odoo>
